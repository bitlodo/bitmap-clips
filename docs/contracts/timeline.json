{
  "format": "bitmap-timeline-contract",
  "formatVersion": 1,
  "controls": [
    {
      "key": "fadeInFrames",
      "label": "Fade in / seconds"
    },
    {
      "key": "fadeOutFrames",
      "label": "Fade out / seconds"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "startFrame": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "durationFrames": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      },
      "fadeInFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      },
      "fadeOutFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      }
    },
    "required": [
      "startFrame",
      "durationFrames",
      "fadeInFrames",
      "fadeOutFrames"
    ],
    "additionalProperties": false
  }
}
