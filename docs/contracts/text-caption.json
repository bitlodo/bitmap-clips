{
  "format": "bitmap-text-contract",
  "formatVersion": 1,
  "id": "caption",
  "settingsVersion": 1,
  "name": "Text badge",
  "description": "A compact message with one text field.",
  "layout": "screen",
  "supportedProperties": [
    "Custom text"
  ],
  "durationFrames": {
    "min": 15,
    "default": 90
  },
  "controls": [
    {
      "key": "text",
      "label": "Message",
      "kind": "textarea",
      "maxLength": 500
    }
  ],
  "timelineControls": [
    {
      "key": "fadeInFrames",
      "label": "Fade in / seconds"
    },
    {
      "key": "fadeOutFrames",
      "label": "Fade out / seconds"
    }
  ],
  "modules": [
    "text-style",
    "fade"
  ],
  "settingsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "text": {
        "default": "Your message here",
        "type": "string",
        "maxLength": 500
      }
    }
  },
  "commonInstanceSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "startFrame": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "durationFrames": {
        "type": "integer",
        "minimum": 15,
        "maximum": 9007199254740991
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "type": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "settingsVersion": {
        "type": "number",
        "const": 1
      },
      "position": {
        "type": "string",
        "enum": [
          "bottom",
          "center",
          "top"
        ]
      },
      "scale": {
        "type": "number",
        "minimum": 0.7,
        "maximum": 1.4
      },
      "textStyleOverride": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "font": {
                "type": "string",
                "enum": [
                  "sans",
                  "modern",
                  "serif",
                  "mono",
                  "classic",
                  "bitmap"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "secondaryColor": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "accent": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "panelColor": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "fadeInFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      },
      "fadeOutFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      }
    },
    "required": [
      "startFrame",
      "durationFrames",
      "id",
      "type",
      "settingsVersion",
      "position",
      "scale",
      "textStyleOverride",
      "fadeInFrames",
      "fadeOutFrames"
    ],
    "additionalProperties": false
  }
}
