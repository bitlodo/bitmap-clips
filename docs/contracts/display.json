{
  "format": "bitmap-clip-contract",
  "formatVersion": 1,
  "id": "display",
  "settingsVersion": 1,
  "name": "Display",
  "description": "Show the complete bitmap, still or with continuous animation.",
  "complexity": "simple",
  "durationFrames": {
    "min": 30,
    "max": 1800,
    "default": 150
  },
  "controls": [
    {
      "key": "displayAnimation",
      "label": "Display animation",
      "kind": "select",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "pulse",
          "label": "Pulse"
        },
        {
          "value": "wave",
          "label": "Wave"
        }
      ]
    },
    {
      "key": "displaySpeed",
      "label": "Speed",
      "kind": "range",
      "min": 1,
      "max": 10,
      "step": 1,
      "when": {
        "key": "displayAnimation",
        "value": "pulse"
      }
    },
    {
      "key": "displaySpeed",
      "label": "Speed",
      "kind": "range",
      "min": 1,
      "max": 10,
      "step": 1,
      "when": {
        "key": "displayAnimation",
        "value": "wave"
      }
    },
    {
      "key": "displayIntensity",
      "label": "Intensity",
      "kind": "range",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "unit": "percent",
      "when": {
        "key": "displayAnimation",
        "value": "pulse"
      }
    },
    {
      "key": "displayIntensity",
      "label": "Intensity",
      "kind": "range",
      "min": 0.1,
      "max": 1,
      "step": 0.1,
      "unit": "percent",
      "when": {
        "key": "displayAnimation",
        "value": "wave"
      }
    }
  ],
  "cameraControls": [
    {
      "key": "cameraA",
      "label": "Initial camera",
      "at": 0
    }
  ],
  "timelineControls": [
    {
      "key": "fadeInFrames",
      "label": "Fade in / seconds"
    },
    {
      "key": "fadeOutFrames",
      "label": "Fade out / seconds"
    }
  ],
  "modules": [
    "camera",
    "scene-style",
    "fade"
  ],
  "settingsSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "displayAnimation": {
        "default": "none",
        "type": "string",
        "enum": [
          "none",
          "pulse",
          "wave"
        ]
      },
      "displaySpeed": {
        "default": 2,
        "type": "number",
        "minimum": 1,
        "maximum": 10
      },
      "displayIntensity": {
        "default": 0.3,
        "type": "number",
        "minimum": 0.1,
        "maximum": 1
      }
    }
  },
  "commonInstanceSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "startFrame": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "durationFrames": {
        "type": "integer",
        "minimum": 30,
        "maximum": 1800
      },
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "type": {
        "type": "string",
        "minLength": 1
      },
      "settingsVersion": {
        "type": "number",
        "const": 1
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999999
      },
      "framing": {
        "type": "object",
        "properties": {
          "yawOffset": {
            "type": "number",
            "minimum": -60,
            "maximum": 60
          },
          "pitchOffset": {
            "type": "number",
            "minimum": -20,
            "maximum": 20
          },
          "zoom": {
            "type": "number",
            "minimum": 0.75,
            "maximum": 1.3
          }
        },
        "required": [
          "yawOffset",
          "pitchOffset",
          "zoom"
        ],
        "additionalProperties": false
      },
      "styleOverride": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "cubeType": {
                "type": "string",
                "enum": [
                  "square",
                  "chamfered",
                  "rounded-small",
                  "rounded-large"
                ]
              },
              "cameraType": {
                "type": "string",
                "enum": [
                  "perspective",
                  "isometric"
                ]
              },
              "background": {
                "type": "string",
                "enum": [
                  "void",
                  "studio",
                  "paper"
                ]
              },
              "backgroundColor": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "material": {
                "type": "string",
                "enum": [
                  "solid",
                  "neon",
                  "wireframe",
                  "hologram"
                ]
              },
              "accent": {
                "type": "string",
                "pattern": "^#[a-f\\d]{6}$"
              },
              "bloom": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.6
              },
              "shadows": {
                "type": "boolean"
              },
              "grid": {
                "type": "boolean"
              },
              "scanlines": {
                "type": "boolean"
              },
              "shadowOpacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "fog": {
                "type": "boolean"
              },
              "fogNear": {
                "type": "number",
                "minimum": 0,
                "maximum": 20
              },
              "fogFar": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 40
              },
              "lightRotation": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lightIntensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 8
              },
              "ambientIntensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              "rimIntensity": {
                "type": "number",
                "minimum": 0,
                "maximum": 8
              }
            },
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "fadeInFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      },
      "fadeOutFrames": {
        "type": "number",
        "minimum": 0,
        "maximum": 60
      }
    },
    "required": [
      "startFrame",
      "durationFrames",
      "id",
      "type",
      "settingsVersion",
      "seed",
      "framing",
      "styleOverride",
      "fadeInFrames",
      "fadeOutFrames"
    ],
    "additionalProperties": false
  },
  "implementation": "src/clips/display/index.ts"
}
